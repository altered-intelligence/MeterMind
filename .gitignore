# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Local data / secrets — NEVER commit
# (uploaded PDFs, SQLite DB + backups, HMAC secret key, local model pref)
# NOTE: keep comments on their OWN lines. Git does NOT treat a '#' that follows
# a pattern on the same line as a comment — it becomes part of the pattern and
# silently breaks the ignore (this previously leaked backend/var/ into staging).
backend/var/
**/.secret_key
*.sqlite
*.db*
.env

# Real utility bills (contain PII) — do not commit
CoServe-Bills/
sample_bills/*.pdf

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/

# OS
.DS_Store

# Env-specific npm CA workaround (corporate TLS proxy)
frontend/.node-ca.pem
frontend/.npmrc
